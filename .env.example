# Credentials for the bosch-xmpp CLI (`npm run zones`, `npm run bosch`).
# Copy this file to .env and fill it in. .env is gitignored; never commit real
# values.
#
# Serial number and access key are printed on the back of the CT200 (dashes can
# be left out). The password is the device password set in the EasyControl app
# under Menu -> Settings -> Personal -> Change password, not the Bosch SingleKey
# ID password.
BOSCH_XMPP_SERIAL_NUMBER=
BOSCH_XMPP_ACCESS_KEY=
BOSCH_XMPP_PASSWORD=
