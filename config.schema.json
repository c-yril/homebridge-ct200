{
    "pluginAlias": "CT200",
    "pluginType": "platform",
    "singular": true,
    "strictValidation": false,
    "customUi": true,
    "headerDisplay": "Control a Bosch EasyControl CT200 (and compatible devices such as the Buderus TC100 v2) from HomeKit, over the Bosch cloud.",
    "footerDisplay": "This plugin talks to the CT200 through the Bosch cloud using your SingleKey ID. Use the **Log in with Bosch** button above to sign in — Homebridge then stays logged in automatically. See the [README](https://github.com/c-yril/homebridge-ct200#readme) for details.",
    "schema": {
        "type": "object",
        "required": [
            "refreshToken",
            "zones"
        ],
        "properties": {
            "refreshToken": {
                "title": "Bosch refresh token",
                "x-schema-form": {
                    "type": "password"
                },
                "type": "string",
                "default": "",
                "description": "Set automatically by the \"Log in with Bosch\" button above. You can also paste a refresh token here manually.",
                "required": true
            },
            "away": {
                "title": "Away switch",
                "type": "boolean",
                "description": "Show away switch",
                "default": true,
                "required": false
            },
            "zoneInterval": {
                "title": "Zone interval",
                "type": "integer",
                "description": "How often to query zone info (minutes)",
                "default": 2,
                "minimum": 1,
                "required": false
            },
            "auxInterval": {
                "title": "Auxiliary interval",
                "type": "integer",
                "description": "How often to query humidity, localization, away and per-zone target info (minutes)",
                "default": 5,
                "minimum": 1,
                "required": false
            },
            "zones": {
                "title": "Zones",
                "type": "array",
                "items": {
                    "title": "Zone",
                    "type": "object",
                    "required": [
                        "index",
                        "name"
                    ],
                    "properties": {
                        "index": {
                            "title": "Zone index",
                            "type": "integer",
                            "default": 1,
                            "minimum": 1,
                            "required": true
                        },
                        "name": {
                            "title": "Zone name",
                            "type": "string",
                            "default": "Thermostat",
                            "required": true
                        }
                    }
                }
            }
        }
    }
}
