{
    "pluginAlias": "CT200",
    "pluginType": "platform",
    "singular": true,
    "strictValidation": false,
    "headerDisplay": "Control a Bosch EasyControl CT200 (and compatible devices such as the Buderus TC100 v2) from HomeKit.",
    "footerDisplay": "The password is the **device** password set in the EasyControl app under *Settings → Personal → Change Password* — not your Bosch SingleKey ID password. See the [troubleshooting notes](https://github.com/c-yril/homebridge-ct200#troubleshooting) if you get login errors.",
    "schema": {
        "type": "object",
        "required": [
            "access",
            "serial",
            "password",
            "zones"
        ],
        "properties": {
            "access": {
                "title": "Access Key",
                "x-schema-form": {
                    "type": "password"
                },
                "type": "string",
                "default": "",
                "description": "Printed on the back of the device, and shown in the EasyControl app (16 letters). Dashes are ignored, so it can be pasted as printed.",
                "pattern": "^[A-Za-z0-9-]*$",
                "minLength": 16,
                "maxLength": 24,
                "required": true
            },
            "serial": {
                "title": "Serial key",
                "type": "string",
                "pattern": "^[0-9-]*$",
                "description": "Printed on the back of the device, and shown in the EasyControl app (9 digits). Dashes are ignored, so it can be pasted as printed.",
                "default": "",
                "minLength": 9,
                "maxLength": 14,
                "required": true
            },
            "password": {
                "title": "Password",
                "x-schema-form": {
                    "type": "password"
                },
                "type": "string",
                "description": "Set it in the EasyControl app: Menu \u2192 Settings \u2192 Personal \u2192 Change password. This is not your Bosch SingleKey ID password.",
                "default": "",
                "required": true
            },
            "away": {
                "title": "Away switch",
                "type": "boolean",
                "description": "Show away switch",
                "default": true,
                "required": false
            },
            "zoneInterval": {
                "title": "Zone interval",
                "type": "integer",
                "description": "How often to query zone info (minutes)",
                "default": 2,
                "minimum": 1,
                "required": false
            },
            "auxInterval": {
                "title": "Auxiliary interval",
                "type": "integer",
                "description": "How often to query humidity, localization, away and per-zone target info (minutes)",
                "default": 5,
                "minimum": 1,
                "required": false
            },
            "zones": {
                "title": "Zones",
                "type": "array",
                "items": {
                    "title": "Zone",
                    "type": "object",
                    "required": [
                        "index",
                        "name"
                    ],
                    "properties": {
                        "index": {
                            "title": "Zone index",
                            "type": "integer",
                            "default": 1,
                            "minimum": 1,
                            "required": true
                        },
                        "name": {
                            "title": "Zone name",
                            "type": "string",
                            "default": "Thermostat",
                            "required": true
                        }
                    }
                }
            }
        }
    }
}
