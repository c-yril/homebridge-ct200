{
    "displayName": "Homebridge CT200",
    "name": "homebridge-ct200",
    "version": "3.0.0",
    "description": "Homebridge plugin to control Bosch CT200 smart thermostat.",
    "license": "MIT",
    "author": "Domas Kalinauskas",
    "homepage": "https://github.com/lynxcs/homebridge-ct200#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lynxcs/homebridge-ct200.git"
    },
    "bugs": {
        "url": "https://github.com/lynxcs/homebridge-ct200/issues"
    },
    "engines": {
        "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
        "homebridge": "^1.8.0 || ^2.0.0"
    },
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "config.schema.json"
    ],
    "scripts": {
        "lint": "eslint . --max-warnings=0",
        "watch": "npm run build && npm link && nodemon",
        "build": "rimraf ./dist && tsc",
        "prepublishOnly": "npm run lint && npm run build"
    },
    "keywords": [
        "homebridge-plugin",
        "supports-hap",
        "homekit",
        "bosch",
        "ct200",
        "easycontrol",
        "buderus",
        "tc100"
    ],
    "dependencies": {
        "bosch-xmpp": "^2.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.18.0",
        "eslint": "^10.10.0",
        "homebridge": "^2.4.0",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.70.0"
    }
}
