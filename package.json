{
  "displayName": "Homebridge CT200",
  "name": "@c-yril/homebridge-ct200",
  "version": "3.1.0",
  "description": "Homebridge plugin to control the Bosch EasyControl CT200 smart thermostat. Fork of homebridge-ct200 with Homebridge 2 support.",
  "license": "MIT",
  "author": "Domas Kalinauskas",
  "homepage": "https://github.com/c-yril/homebridge-ct200#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c-yril/homebridge-ct200.git"
  },
  "bugs": {
    "url": "https://github.com/c-yril/homebridge-ct200/issues"
  },
  "engines": {
    "node": "^22.10.0 || ^24.0.0 || ^26.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "bosch": "dotenvx run --quiet -- node scripts/bosch.js",
    "zones": "npm run bosch -- get /zones/list",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run build",
    "password": "dotenvx run --quiet -- node scripts/bosch-password.js"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "homekit",
    "bosch",
    "ct200",
    "easycontrol",
    "buderus",
    "tc100"
  ],
  "dependencies": {
    "bosch-xmpp": "^2.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "contributors": [
    "Cyril Lacheretz"
  ],
  "publishConfig": {
    "access": "public"
  }
}
